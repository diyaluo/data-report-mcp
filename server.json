{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.diyaluo/data-report-mcp",
  "description": "Local-first CSV/XLSX analysis report MCP server (stats, Excel charts, Markdown), no upload.",
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/diyaluo/data-report-mcp:v0.1.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "docker",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "run"
        },
        {
          "type": "positional",
          "value": "-i"
        },
        {
          "type": "positional",
          "value": "--rm"
        },
        {
          "type": "positional",
          "value": "ghcr.io/diyaluo/data-report-mcp:v0.1.0"
        }
      ]
    }
  ],
  "tools": [
    {
      "name": "analyze_table"
    },
    {
      "name": "health"
    }
  ]
}